#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LAB_ROOT="${RESEARCH_LAB_ROOT:-$ROOT/.lab}"
PY=(python3 "$ROOT/scripts/research_lab.py")
SETUP=(python3 "$ROOT/scripts/setup_harnesses.py")

command="${1:-}"
dry_run=0
selected=""

for arg in "$@"; do
  if [[ "$arg" == "--dry-run" ]]; then
    dry_run=1
  fi
done

if [[ "$command" == "setup" ]]; then
  shift
  exec "${SETUP[@]}" "$@"
fi

# A real benchmark should be runnable from a fresh checkout. Prepare only the
# selected harnesses that are actually missing; the idempotent setup helper
# verifies pinned revisions and dependency recipe markers before doing work.
# Set RESEARCH_LAB_AUTO_SETUP=0 to opt out.
if [[ "$dry_run" -eq 0 && "${RESEARCH_LAB_AUTO_SETUP:-1}" != "0" ]]; then
  case "$command" in
    matrix)
      selected="starintel,researchharness,gpt-researcher,smolagents-odr"
      args=("$@")
      for ((i=0; i<${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--harnesses" && $((i + 1)) -lt ${#args[@]} ]]; then
          selected="${args[$((i + 1))]}"
        elif [[ "${args[$i]}" == --harnesses=* ]]; then
          selected="${args[$i]#--harnesses=}"
        fi
      done
      ;;
    run)
      args=("$@")
      for ((i=0; i<${#args[@]}; i++)); do
        if [[ "${args[$i]}" == "--harness" && $((i + 1)) -lt ${#args[@]} ]]; then
          selected="${args[$((i + 1))]}"
        elif [[ "${args[$i]}" == --harness=* ]]; then
          selected="${args[$i]#--harness=}"
        fi
      done
      ;;
  esac

  if [[ -n "$selected" ]]; then
    echo "[lab] verifying harness environments: $selected"
    "${SETUP[@]}" --harnesses "$selected"
  fi
fi

set +e
"${PY[@]}" "$@"
rc=$?
set -e

if (( rc != 0 )) && [[ "$command" == "matrix" || "$command" == "run" ]]; then
  echo >&2
  echo "[lab] run failed. Each lane keeps stderr.log, stdout.log, result.json, and MCP diagnostics." >&2
  echo "[lab] newest result files:" >&2
  echo "  find runs -name result.json -printf '%T@ %p\n' | sort -nr | head -n 8" >&2
fi

exit "$rc"
