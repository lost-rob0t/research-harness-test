{
  "schema": "research-harness-test.harnesses.v1",
  "default_model": "z-ai/glm-5.3-flash",
  "default_parallel": 4,
  "default_timeout_seconds": 1800,
  "default_harnesses": [
    "starintel",
    "researchharness",
    "gpt-researcher",
    "smolagents-odr"
  ],
  "retrieval": {
    "search": "mcp:brave/brave_web_search",
    "fetch": "mcp:fetch/fetch",
    "config": "mcp/servers.json"
  },
  "harnesses": {
    "starintel": {
      "name": "StarIntel Auto Research CL",
      "repo": "git@git.starintel.actor:starintel-labs/auto-research-llm-cl.git",
      "ref": "c80c585b82625a90c559e5b1e7100064dc899431",
      "adapter": "starintel",
      "enabled": true,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY", "AR_RUNTIME_SOURCE"],
      "retrieval_mode": "mcp-prefetch"
    },
    "researchharness": {
      "name": "InternScience ResearchHarness",
      "repo": "ssh://git@ssh.github.com:443/InternScience/ResearchHarness.git",
      "ref": "72e8a44737aadabc8c3f9e5c7ea76883b9c7032f",
      "adapter": "researchharness",
      "enabled": true,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY"],
      "retrieval_mode": "mcp-tools"
    },
    "gpt-researcher": {
      "name": "GPT Researcher",
      "repo": "ssh://git@ssh.github.com:443/assafelovic/gpt-researcher.git",
      "ref": "6f998577d547b1e54ec662dac63583aa11e3b84b",
      "adapter": "gpt_researcher",
      "enabled": true,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY"],
      "retrieval_mode": "mcp-custom-retriever"
    },
    "smolagents-odr": {
      "name": "Hugging Face Open Deep Research",
      "repo": "ssh://git@ssh.github.com:443/huggingface/smolagents.git",
      "ref": "30bb1161095dbae2271e6bc3cc4c219cc3897a57",
      "adapter": "smolagents_odr",
      "enabled": true,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY"],
      "retrieval_mode": "mcp-tools"
    },
    "langchain-odr": {
      "name": "LangChain Open Deep Research",
      "repo": "ssh://git@ssh.github.com:443/langchain-ai/open_deep_research.git",
      "ref": "main",
      "adapter": "langchain_odr",
      "enabled": false,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY"],
      "note": "Scaffolded; enable after its controlled MCP tool path is pinned and verified."
    },
    "storm": {
      "name": "Stanford STORM",
      "repo": "ssh://git@ssh.github.com:443/stanford-oval/storm.git",
      "ref": "main",
      "adapter": "storm",
      "enabled": false,
      "required_env": ["OPENROUTER_API_KEY", "BRAVE_API_KEY"],
      "note": "Scaffolded specialist lane; enable after its controlled MCP tool path is pinned and verified."
    }
  }
}
