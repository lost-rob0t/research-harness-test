# Research Harness Test Lab
# Copy to .env or export from your shell. Never commit real keys.

export OPENROUTER_API_KEY=
export RESEARCH_LAB_MODEL=z-ai/glm-5.3-flash
export RESEARCH_LAB_PARALLEL=4
export RESEARCH_LAB_TIMEOUT=1800
export RESEARCH_LAB_ROOT="$PWD/.lab"

# Shared/search-provider credentials used by individual harnesses.
export TAVILY_API_KEY=
export SERPER_KEY=
export SERPAPI_API_KEY=
export JINA_KEY=
export MINERU_TOKEN=
export HF_TOKEN=

# Native StarIntel lane.  The adapter creates an isolated worktree/daemon for
# each benchmark run and delegates to the pinned checkout under .lab/upstreams.
export STARINTEL_AUTO_RESEARCH_PATH="$PWD/adapters/starintel"
export STARINTEL_PROJECT=auto-research
export AR_RUNTIME_SOURCE="$HOME/git/worktrees/auto-research-harness-cl-runtime/"
