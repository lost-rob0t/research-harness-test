#!/usr/bin/env bash
set -euo pipefail

LAB_REPO="$(cd "$(dirname "$0")/../../.." && pwd)"
LAB_ROOT="${RESEARCH_LAB_ROOT:-$LAB_REPO/.lab}"
UPSTREAM="$LAB_ROOT/upstreams/starintel"
OUTPUT="${RESEARCH_LAB_OUTPUT:-}"

if [ ! -x "$UPSTREAM/bin/research" ]; then
  echo "starintel adapter: pinned checkout missing; run: bash bin/research-lab setup --harnesses starintel" >&2
  exit 2
fi
if [ -z "$OUTPUT" ]; then
  echo "starintel adapter: RESEARCH_LAB_OUTPUT is required" >&2
  exit 2
fi
if [ -z "${AR_RUNTIME_SOURCE:-}" ]; then
  echo "starintel adapter: AR_RUNTIME_SOURCE is required" >&2
  exit 2
fi
if [ ! -d "$AR_RUNTIME_SOURCE" ]; then
  echo "starintel adapter: AR_RUNTIME_SOURCE is not an existing directory: $AR_RUNTIME_SOURCE" >&2
  exit 2
fi

mkdir -p "$OUTPUT"
CORPUS="$OUTPUT/starintel-corpus"
MARKER="$OUTPUT/.starintel-start"
NATIVE_STDOUT="$OUTPUT/starintel-native.stdout.log"
NATIVE_STDERR="$OUTPUT/starintel-native.stderr.log"

# One clean corpus per benchmark run. No durable writes land in the developer
# checkout or the shared pinned checkout.
git -C "$UPSTREAM" worktree add --detach "$CORPUS" HEAD >/dev/null

# The pinned StarIntel corpus validates every configured project's source path
# while loading trusted config, even though this benchmark invokes only the
# auto-research project. Keep the real auto-research runtime source, while
# satisfying those unrelated project registrations with isolated empty dirs.
# Explicit caller overrides still win.
BENCH_SOURCE_ROOT="$OUTPUT/starintel-benchmark-sources"
mkdir -p "$BENCH_SOURCE_ROOT/prolog-rlm" "$BENCH_SOURCE_ROOT/star-lang"
export AR_HARNESS_SOURCE="${AR_HARNESS_SOURCE:-$AR_RUNTIME_SOURCE}"
export AR_PROLOG_RLM_SOURCE="${AR_PROLOG_RLM_SOURCE:-$BENCH_SOURCE_ROOT/prolog-rlm}"
export AR_STAR_LANG_SOURCE="${AR_STAR_LANG_SOURCE:-$BENCH_SOURCE_ROOT/star-lang}"

# Each run gets its own daemon identity. This also permits multiple StarIntel
# replicas in the same wider benchmark without sharing process state.
slot="$(printf '%s' "$OUTPUT" | cksum | awk '{print $1 % 900}')"
export AR_CORPUS_ROOT="$CORPUS"
export AR_WEB_PORT="$((18080 + slot))"
export AR_PIDFILE="$OUTPUT/starintel-daemon.pid"
export AR_LOGFILE="$OUTPUT/starintel-daemon.log"
API="http://127.0.0.1:$AR_WEB_PORT/api/v1"
TOKEN="${AR_OPERATOR_TOKEN:-dev-operator-token}"

cleanup() {
  set +e
  if [ -x "$CORPUS/bin/research" ]; then
    "$CORPUS/bin/research" stop >/dev/null 2>&1
  fi
  git -C "$UPSTREAM" worktree remove --force "$CORPUS" >/dev/null 2>&1
}
trap cleanup EXIT

: > "$MARKER"

set +e
"$CORPUS/bin/research" "$@" \
  > >(tee "$NATIVE_STDOUT") \
  2> >(tee "$NATIVE_STDERR" >&2)
rc=$?
set -e

run_id="$(sed -n 's/^run \([^ ]*\) queued.*/\1/p' "$NATIVE_STDOUT" | tail -n1)"
native_status="$(sed -n 's/^== run [^:]*: \([^ ]*\) ==$/\1/p' "$NATIVE_STDOUT" | tail -n1)"

# Capture the raw append-only event ledger before the worktree is removed.
# The current HTTP event projection intentionally omits payload, which is
# exactly where rlm.failed stores the provider/bridge failure detail.
if [ -s "$CORPUS/.ar-events.jsonl" ]; then
  cp "$CORPUS/.ar-events.jsonl" "$OUTPUT/starintel-events-raw.jsonl"
  python3 - "$OUTPUT/starintel-events-raw.jsonl" "$run_id" <<'PY' >&2 || true
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
run_id = sys.argv[2]
failed = []
for raw in path.read_text(errors="replace").splitlines():
    try:
        event = json.loads(raw)
    except json.JSONDecodeError:
        continue
    if run_id and event.get("entity_id") != run_id:
        continue
    if event.get("type") == "rlm.failed":
        failed.append(event)
if failed:
    print("=== starintel raw rlm.failed ===")
    print(json.dumps(failed[-1], indent=2, ensure_ascii=False))
PY
fi

# cl-prolog-rlm writes bridge stderr to PID/UUID-scoped files in /tmp. Keep
# only files created during this benchmark run, so Prolog boot/provider errors
# survive daemon teardown and are associated with the run artifact.
BRIDGE_DIR="$OUTPUT/rlm-bridge-stderr"
mkdir -p "$BRIDGE_DIR"
while IFS= read -r path; do
  cp "$path" "$BRIDGE_DIR/$(basename "$path")"
done < <(find /tmp -maxdepth 1 -type f -name 'rlm-bridge-stderr-*.log' -newer "$MARKER" -print 2>/dev/null || true)
if compgen -G "$BRIDGE_DIR/rlm-bridge-stderr-*.log" >/dev/null; then
  newest="$(find "$BRIDGE_DIR" -type f -name 'rlm-bridge-stderr-*.log' -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)"
  if [ -s "$newest" ]; then
    echo "=== starintel RLM bridge stderr ===" >&2
    cat "$newest" >&2
  fi
fi

# Capture the authoritative API payloads while the isolated daemon is still
# alive. The pinned upstream CLI currently prints only event names and can
# itself fail while formatting candidates, which used to hide the real RLM
# error. These files retain the public projections alongside the raw ledger.
if [ -n "$run_id" ]; then
  curl -sS -m 10 -H "Authorization: Bearer $TOKEN" \
    "$API/runs/$run_id" > "$OUTPUT/starintel-run.json" || true
  curl -sS -m 10 -H "Authorization: Bearer $TOKEN" \
    "$API/runs/$run_id/events" > "$OUTPUT/starintel-events.json" || true
  curl -sS -m 10 -H "Authorization: Bearer $TOKEN" \
    "$API/runs/$run_id/candidates" > "$OUTPUT/starintel-candidates.json" || true

  if [ -s "$OUTPUT/starintel-run.json" ]; then
    python3 - "$OUTPUT/starintel-run.json" <<'PY' >&2 || true
import json
import sys
from pathlib import Path

try:
    data = json.loads(Path(sys.argv[1]).read_text())
except Exception:
    raise SystemExit(0)

print("=== starintel native run ===")
print(json.dumps(data, indent=2, ensure_ascii=False))
error = data.get("error") if isinstance(data, dict) else None
if error:
    print("=== starintel native error ===")
    print(json.dumps(error, indent=2, ensure_ascii=False))
PY
  fi
fi

# Preserve and surface the full daemon log on native failure, not only
# upstream's final stack frames. Startup failures and runtime failures are
# both retained, while the raw ledger/bridge stderr carry semantic failures.
if (( rc != 0 )) && [ -s "$AR_LOGFILE" ]; then
  echo "=== starintel daemon log ===" >&2
  sed -n '1,160p' "$AR_LOGFILE" >&2
  lines="$(wc -l < "$AR_LOGFILE")"
  if (( lines > 160 )); then
    echo "=== starintel daemon tail ===" >&2
    tail -100 "$AR_LOGFILE" >&2
  fi
fi

ARTIFACT_ROOT="$OUTPUT/native-artifacts"
mkdir -p "$ARTIFACT_ROOT"
while IFS= read -r path; do
  rel="${path#"$CORPUS/"}"
  dest="$ARTIFACT_ROOT/$rel"
  mkdir -p "$(dirname "$dest")"
  cp "$path" "$dest"
done < <(find "$CORPUS/roam" -type f -newer "$MARKER" -print 2>/dev/null || true)

latest=""
if [ -d "$CORPUS/roam/research" ]; then
  latest="$(find "$CORPUS/roam/research" -type f -name '*.org' -newer "$MARKER" -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr | head -n1 | cut -d' ' -f2- || true)"
fi
if [ -z "$latest" ] && [ -d "$CORPUS/roam/design" ]; then
  latest="$(find "$CORPUS/roam/design" -type f -name '*.org' -newer "$MARKER" -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr | head -n1 | cut -d' ' -f2- || true)"
fi

artifact_rel=""
if [ -n "$latest" ]; then
  cp "$latest" "$OUTPUT/report.md"
  artifact_rel="${latest#"$CORPUS/"}"
elif [ -s "$NATIVE_STDOUT" ]; then
  cp "$NATIVE_STDOUT" "$OUTPUT/report.md"
fi

# The pinned corpus CLI has a presentation-layer candidates parser bug that
# can return rc=1 after a genuinely completed native run. Do not let that
# reporting defect turn a completed benchmark lane into a false failure.
if [ "$native_status" = "completed" ] && (( rc != 0 )); then
  echo "starintel adapter: upstream CLI failed after native completion; preserving completed status" >&2
  rc=0
fi

python3 - "$OUTPUT/adapter-result.json" "$run_id" "$native_status" "$artifact_rel" "$AR_WEB_PORT" <<'PY'
import json
import sys
from pathlib import Path

path, run_id, status, artifact, port = sys.argv[1:]
Path(path).write_text(json.dumps({
    "adapter": "starintel-auto-research-cl",
    "native_run_id": run_id or None,
    "native_status": status or None,
    "source_artifact": artifact or None,
    "artifact_capture": "newer-than-run-marker",
    "isolated_corpus": True,
    "isolated_port": int(port),
    "benchmark_source_isolation": True,
    "native_run_snapshot": "starintel-run.json" if run_id else None,
    "native_events_snapshot": "starintel-events.json" if run_id else None,
    "native_events_raw": "starintel-events-raw.jsonl" if Path(path).with_name("starintel-events-raw.jsonl").exists() else None,
    "native_candidates_snapshot": "starintel-candidates.json" if run_id else None,
    "rlm_bridge_stderr_dir": "rlm-bridge-stderr",
}, indent=2) + "\n")
PY

rm -f "$MARKER"
exit "$rc"
